--- a/drivers/block/zram/zram_drv.c	2026-09-01 22:04:41.838465680 +0200
+++ b/drivers/block/zram/zram_drv.c	2026-09-23 22:54:24.896628240 +0200
@@ -15,6 +15,8 @@
 #define pr_fmt(fmt) "zram: " fmt
 
 #include <linux/module.h>
+#include <linux/prefetch.h>
+#include <asm/cacheflush.h>
 #include <linux/kernel.h>
 #include <linux/bio.h>
 #include <linux/bitops.h>
@@ -2099,6 +2101,13 @@
 	return 0;
 }
 
+/* EXPERIMENT: switch the prefetch before decompression on and off at run time */
+static int zram_prefetch; /* 1 the destination, 2 the source, 3 both */
+module_param(zram_prefetch, int, 0644);
+/* EXPERIMENT: flush the compressed data first, as if it had not been read for a long time */
+static bool zram_flush_src;
+module_param(zram_flush_src, bool, 0644);
+
 static int read_compressed_page(struct zram *zram, struct page *page,
 				unsigned long index)
 {
@@ -2116,6 +2125,22 @@
 	src = zs_obj_read_begin(zram->mem_pool, handle, size,
 				zstrm->local_copy);
 	dst = kmap_local_page(page);
+	if (READ_ONCE(zram_flush_src)) {
+		clflush_cache_range(src, size);
+		mb();
+	}
+	{
+		/* EXPERIMENT: the destination for writing and the compressed data at once */
+		int what = READ_ONCE(zram_prefetch);
+		char *p;
+
+		if (what & 1)
+			for (p = (char *)dst; p < (char *)dst + PAGE_SIZE; p += L1_CACHE_BYTES)
+				prefetchw(p);
+		if (what & 2)
+			for (p = (char *)src + L1_CACHE_BYTES; p < (char *)src + size; p += L1_CACHE_BYTES)
+				prefetch(p);
+	}
 	ret = zcomp_decompress(zram->comps[prio], zstrm, src, size, dst);
 	kunmap_local(dst);
 	zs_obj_read_end(zram->mem_pool, handle, size, src);
