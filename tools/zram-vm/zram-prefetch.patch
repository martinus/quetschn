+/* EXPERIMENT: switch the prefetch before decompression on and off at run time */
+int zram_prefetch; /* 1 the destination, 2 the source, 3 both, 8 the source in the backend */
+module_param(zram_prefetch, int, 0644);
+/* EXPERIMENT: flush the compressed data first, as if it had not been read for a long time */
+static bool zram_flush_src;
+module_param(zram_flush_src, bool, 0644);
+/* the time the flushes took, to subtract it from a timed swap-in */
+static unsigned long zram_flush_ns;
+module_param(zram_flush_ns, ulong, 0444);
+/* EXPERIMENT: the time of zcomp_decompress() alone, summed, and how many */
+static bool zram_time_decomp;
+module_param(zram_time_decomp, bool, 0644);
+static unsigned long zram_decomp_ns, zram_decomp_n;
+module_param(zram_decomp_ns, ulong, 0444);
+module_param(zram_decomp_n, ulong, 0444);
+/*
+ * EXPERIMENT: warm the backend right before the decompression, outside zram_decomp_ns, to see what of
+ * a fault's decompression is cold caches: 1 its tables and scratch read, 2 a small page decoded, which
+ * warms its code too, only for backends that set zram_warm_fn, today seqlz's (backend_seqlz.c). 3 the
+ * destination page written, for every backend. 4 both 3 and 2. 5 the page of the decompression before
+ * decoded again, a real page as in the read benchmark's "other page first". 6 both 3 and 5. 7 this
+ * very page decoded once before.
+ */
+int zram_warm;
+module_param(zram_warm, int, 0644);
+void (*zram_warm_fn)(struct zcomp_params *params, struct zcomp_ctx *ctx, int what, const void *src,
+		     unsigned int size);
+/*
+ * EXPERIMENT: the guest's hardware counters around the timed zcomp_decompress(), summed like
+ * zram_decomp_ns: cycles, instructions, branch misses, L1 data and instruction cache read misses, data
+ * TLB read misses, in the kernel only. zram.zram_pmu=1 on the kernel command line creates them at boot
+ * on CPU 0, the one CPU of run.sh's VM. Reading them costs a constant number of instructions per call.
+ */
+#define ZRAM_PMU_N 6
+static bool zram_pmu;
+module_param(zram_pmu, bool, 0444);
+static unsigned long zram_pmu_counts[ZRAM_PMU_N];
+static int zram_pmu_n = ZRAM_PMU_N;
+module_param_array(zram_pmu_counts, ulong, &zram_pmu_n, 0444);
+static struct perf_event *zram_pmu_ev[ZRAM_PMU_N];
+
+static void zram_pmu_create(void)
+{
+	static const u64 cache_miss = PERF_COUNT_HW_CACHE_OP_READ << 8 | PERF_COUNT_HW_CACHE_RESULT_MISS << 16;
+	static const struct { u32 type; u64 config; } evs[ZRAM_PMU_N] = {
+		{ PERF_TYPE_HARDWARE, PERF_COUNT_HW_CPU_CYCLES },
+		{ PERF_TYPE_HARDWARE, PERF_COUNT_HW_INSTRUCTIONS },
+		{ PERF_TYPE_HARDWARE, PERF_COUNT_HW_BRANCH_MISSES },
+		{ PERF_TYPE_HW_CACHE, PERF_COUNT_HW_CACHE_L1D | cache_miss },
+		{ PERF_TYPE_HW_CACHE, PERF_COUNT_HW_CACHE_L1I | cache_miss },
+		{ PERF_TYPE_HW_CACHE, PERF_COUNT_HW_CACHE_DTLB | cache_miss },
+	};
+	int k;
+
+	for (k = 0; k < ZRAM_PMU_N; k++) {
+		struct perf_event_attr attr = {
+			.type = evs[k].type,
+			.size = sizeof(attr),
+			.config = evs[k].config,
+			.pinned = 1,
+			.exclude_user = 1,
+			.exclude_hv = 1,
+		};
+		struct perf_event *ev = perf_event_create_kernel_counter(&attr, 0, NULL, NULL, NULL);
+
+		if (IS_ERR(ev))
+			pr_err("zram_pmu: event %d: %ld\n", k, PTR_ERR(ev));
+		else
+			zram_pmu_ev[k] = ev;
+	}
+}
+
+static void zram_pmu_read(u64 *v)
+{
+	int k;
+
+	for (k = 0; k < ZRAM_PMU_N; k++)
+		if (!zram_pmu_ev[k] || perf_event_read_local(zram_pmu_ev[k], &v[k], NULL, NULL))
+			v[k] = 0;
+}
